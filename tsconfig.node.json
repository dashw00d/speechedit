{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "out"
  },
  "include": [
    "scripts/web-server.ts",
    "scripts/review-server.ts",
    "scripts/recording-server.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "electron.vite.config.ts",
    "vite.web.config.ts",
    "src/renderer/src/lib/exportGraph.ts",
    "src/renderer/src/types.ts",
    "src/renderer/src/lib/theme.ts",
    "src/renderer/src/lib/resolver.ts",
    "src/renderer/src/lib/edl.ts",
    "src/renderer/src/lib/takes.ts",
    "src/renderer/src/lib/keyframes.ts"
  ],
  "exclude": ["src/main/**/*.test.ts", "src/shared/**/*.test.ts"]
}
