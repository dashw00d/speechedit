{
  "name": "speechedit",
  "version": "0.1.0",
  "description": "Local-first transcript NLE — cut speech like text.",
  "author": "SpeechEdit",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "start:web": "bun scripts/web-server.ts",
    "smoke:whisper": "env -u ELECTRON_RUN_AS_NODE electron scripts/browser-whisper-smoke.cjs",
    "smoke:transcription": "env -u ELECTRON_RUN_AS_NODE electron scripts/transcription-ui-smoke.cjs",
    "smoke:highlight": "env -u ELECTRON_RUN_AS_NODE electron scripts/highlight-ui-smoke.cjs",
    "smoke:proxy": "env -u ELECTRON_RUN_AS_NODE electron scripts/proxy-ui-smoke.cjs",
    "smoke:edit": "env -u ELECTRON_RUN_AS_NODE electron scripts/edit-ui-smoke.cjs",
    "smoke:recording": "SPEECHEDIT_RECORDING=1 SPEECHEDIT_PASSAGE=1 env -u ELECTRON_RUN_AS_NODE electron scripts/review-ui-smoke.cjs",
    "smoke:progressive-review": "env -u ELECTRON_RUN_AS_NODE electron scripts/progressive-review-smoke.cjs",
    "bench:codecs": "bun scripts/codec-experiment/bench.ts",
    "smoke:real-speech": "env -u ELECTRON_RUN_AS_NODE electron scripts/real-speech-playback-smoke.cjs",
    "smoke:track-visibility": "env -u ELECTRON_RUN_AS_NODE electron scripts/track-visibility-smoke.cjs",
    "smoke:recording-playback": "env -u ELECTRON_RUN_AS_NODE electron scripts/recording-playback-smoke.cjs",
    "smoke:passage": "SPEECHEDIT_PASSAGE=1 env -u ELECTRON_RUN_AS_NODE electron scripts/review-ui-smoke.cjs",
    "smoke:review": "env -u ELECTRON_RUN_AS_NODE electron scripts/review-ui-smoke.cjs",
    "smoke:first-undo": "env -u ELECTRON_RUN_AS_NODE electron scripts/first-session-undo-smoke.cjs",
    "smoke:shared-undo": "env -u ELECTRON_RUN_AS_NODE electron scripts/shared-undo-smoke.cjs",
    "build": "electron-vite build",
    "prepare:win-media": "node scripts/fetch-win-media-tools.mjs",
    "package:win:dir": "bun run prepare:win-media && bun run build && electron-builder --win dir --x64",
    "package:win": "bun run prepare:win-media && bun run build && electron-builder --win zip --x64",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint:theme": "bun src/renderer/src/lib/themeGuard.ts",
    "test": "bun test src/renderer/src/lib",
    "mcp": "bun src/mcp/server.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "jsonrepair": "^3.15.0",
    "mediabunny": "^1.56.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
