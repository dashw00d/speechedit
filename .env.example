# Required for the locked web Demo AI. Set this as a secret in the hosting platform.
OPENROUTER_API_KEY=

# Most platforms inject PORT automatically.
PORT=3000
HOST=0.0.0.0

# Optional persistent server cache for the browser Whisper model files.
SPEECHEDIT_CACHE_DIR=.cache/speechedit-browser-whisper

# Optional per-IP in-memory guard for the shared demo key.
SPEECHEDIT_DEMO_REQUESTS_PER_HOUR=10
SPEECHEDIT_DEMO_REQUESTS_PER_DAY=40

# Review previews and feedback. Use a persistent volume in production.
SPEECHEDIT_REVIEW_DIR=.cache/speechedit-reviews
